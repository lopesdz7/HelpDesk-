  "components": [
    {
      "name": "Botão primário",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Ação principal: grafite com texto branco, canto 5px.",
      "html": "<button class=\"ds-btn ds-btn-primary\"><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M12 5v14M5 12h14\"/></svg>Novo chamado</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:40px;padding:0 16px;border:0;border-radius:var(--radius-sm,5px);font-family:Lato,ui-sans-serif,system-ui,sans-serif;font-size:14px;font-weight:700;cursor:pointer;transition:background-color 150ms,color 150ms}.ds-btn-primary{background:var(--color-gray-200,#1e2024);color:var(--color-white,#fff)}.ds-btn-primary:hover,.ds-btn-primary:active{background:var(--color-gray-100,#151619)}.ds-btn:focus-visible{outline:2px solid var(--color-blue-base,#5165e1);outline-offset:2px}.ds-btn:disabled{opacity:.5;pointer-events:none}"
    },
    {
      "name": "Botão secundário",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Ação secundária e padrão dos botões só de ícone.",
      "html": "<button class=\"ds-btn2\">Cancelar</button>",
      "css": ".ds-btn2{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:40px;padding:0 16px;border:0;border-radius:var(--radius-sm,5px);background:var(--color-gray-500,#e3e5e8);color:var(--color-gray-200,#1e2024);font-family:Lato,ui-sans-serif,system-ui,sans-serif;font-size:14px;font-weight:700;cursor:pointer;transition:background-color 150ms,color 150ms}.ds-btn2:hover{background:rgb(227 229 232 / .7);color:var(--color-gray-100,#151619)}.ds-btn2:focus-visible{outline:2px solid var(--color-blue-base,#5165e1);outline-offset:2px}"
    },
    {
      "name": "Campo sublinhado",
      "kind": "input",
      "refersTo": "input",
      "description": "Rótulo 10px maiúsculo + controle só com borda inferior.",
      "html": "<label class=\"ds-field\"><span class=\"ds-field-label\">Título</span><input class=\"ds-input\" placeholder=\"Digite um título para o chamado\"></label>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:4px;font-family:Lato,ui-sans-serif,system-ui,sans-serif}.ds-field-label{font-size:10px;line-height:1.4;font-weight:700;letter-spacing:.02em;text-transform:uppercase;color:var(--color-gray-300,#535964);transition:color 150ms}.ds-field:focus-within .ds-field-label{color:var(--color-blue-base,#5165e1)}.ds-input{height:40px;border:0;border-bottom:1px solid var(--color-gray-500,#e3e5e8);background:transparent;font:inherit;font-size:16px;color:var(--color-gray-200,#1e2024);outline:none;transition:border-color 150ms}.ds-input::placeholder{color:var(--color-muted,#676d7b)}.ds-input:hover{border-bottom-color:var(--color-gray-400,#858b99)}.ds-input:focus{border-bottom-color:var(--color-blue-base,#5165e1)}"
    },
    {
      "name": "Badge de status",
      "kind": "chip",
      "refersTo": "status-badge",
      "description": "Pílula tingida com ícone + texto; flip 3D só na mudança.",
      "html": "<span class=\"ds-badge ds-badge-open\"><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"M9.1 9a3 3 0 0 1 5.8 1c0 2-3 3-3 3M12 17h.01\"/></svg>Aberto</span> <span class=\"ds-badge ds-badge-progress\"><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"M12 6v6l4-2\"/></svg>Em atendimento</span> <span class=\"ds-badge ds-badge-done\"><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M21.8 10A10 10 0 1 1 17 3.3\"/><path d=\"m9 11 3 3L22 4\"/></svg>Encerrado</span>",
      "css": ".ds-badge{display:inline-flex;align-items:center;gap:6px;height:28px;padding:0 8px;border-radius:9999px;font-family:Lato,ui-sans-serif,system-ui,sans-serif;font-size:12px;font-weight:700;white-space:nowrap}.ds-badge-open{background:rgb(204 61 106 / .12);color:var(--color-open-ink,#a3305a)}.ds-badge-progress{background:rgb(53 94 197 / .12);color:var(--color-progress-ink,#355ec5)}.ds-badge-done{background:rgb(80 139 38 / .12);color:var(--color-done-ink,#3d6b1c)}"
    },
    {
      "name": "Card de chamado",
      "kind": "card",
      "refersTo": "card",
      "description": "Card hairline de 10px; a borda escurece no hover e no foco interno.",
      "html": "<article class=\"ds-card\"><span class=\"ds-code\">#00004</span><h3 class=\"ds-card-title\">Rede lenta</h3><p class=\"ds-card-meta\">Instalação de rede</p><div class=\"ds-card-row\"><span>13/04/25 20:56</span><strong>R$ 200,00</strong></div></article>",
      "css": ".ds-card{display:flex;flex-direction:column;gap:4px;padding:20px;border:1px solid var(--color-gray-500,#e3e5e8);border-radius:var(--radius-lg,10px);background:var(--color-gray-600,#f9fafa);font-family:Lato,ui-sans-serif,system-ui,sans-serif;color:var(--color-gray-200,#1e2024);transition:border-color 150ms}.ds-card:hover,.ds-card:focus-within{border-color:var(--color-gray-400,#858b99)}.ds-code{font-size:12px;font-weight:700;color:var(--color-gray-300,#535964);font-variant-numeric:tabular-nums}.ds-card-title{margin:0;font-size:16px;font-weight:700}.ds-card-meta{margin:0;font-size:12px;color:var(--color-gray-300,#535964)}.ds-card-row{display:flex;justify-content:space-between;margin-top:12px;font-size:12px;font-variant-numeric:tabular-nums;color:var(--color-gray-300,#535964)}.ds-card-row strong{color:var(--color-gray-200,#1e2024)}"
    },
    {
      "name": "Navegação lateral",
      "kind": "nav",
      "refersTo": "nav-item-active",
      "description": "Sidebar escura de 200px; item ativo em blue-dark.",
      "html": "<nav class=\"ds-nav\"><a class=\"ds-nav-item is-active\" href=\"#\"><svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M3 5h18M3 12h18M3 19h18\"/></svg>Chamados</a><a class=\"ds-nav-item\" href=\"#\"><svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"8\" r=\"4\"/><path d=\"M4 21a8 8 0 0 1 16 0\"/></svg>Técnicos</a></nav>",
      "css": ".ds-nav{display:flex;flex-direction:column;gap:4px;width:200px;padding:20px 16px;background:var(--color-gray-100,#151619);font-family:Lato,ui-sans-serif,system-ui,sans-serif}.ds-nav-item{display:flex;align-items:center;gap:12px;height:44px;padding:0 16px;border-radius:var(--radius-md,8px);font-size:14px;color:var(--color-gray-400,#858b99);text-decoration:none;transition:background-color 150ms,color 150ms}.ds-nav-item:hover{background:var(--color-gray-200,#1e2024);color:var(--color-gray-500,#e3e5e8)}.ds-nav-item.is-active{background:var(--color-blue-dark,#2e3da3);color:var(--color-gray-600,#f9fafa)}.ds-nav-item:focus-visible{outline:2px solid var(--color-blue-light,#8996eb);outline-offset:2px}"
    },
    {
      "name": "Ticket Value Stub",
      "kind": "custom",
      "refersTo": "ticket-value-stub-total",
      "description": "Assinatura: resumo de valores como canhoto, com notches reais e tracejado.",
      "html": "<section class=\"ds-stub\"><div class=\"ds-stub-body\"><h3>Valores</h3><div class=\"ds-stub-line\"><span><b>Preço base</b><br><i>Instalação de rede</i></span><span>R$ 180,00</span></div><div class=\"ds-stub-line ds-stub-add\"><span>Cabo extra</span><span>R$ 20,00</span></div></div><div class=\"ds-stub-perf\"><span class=\"ds-notch ds-notch-l\"></span><span class=\"ds-notch ds-notch-r\"></span><div class=\"ds-dash\"></div></div><div class=\"ds-stub-total\"><span>Total</span><strong>R$ 200,00</strong></div></section>",
      "css": ".ds-stub{position:relative;max-width:320px;border:1px solid var(--color-gray-500,#e3e5e8);border-radius:var(--radius-lg,10px);background:var(--color-gray-600,#f9fafa);font-family:Lato,ui-sans-serif,system-ui,sans-serif;font-size:12px;color:var(--color-gray-200,#1e2024)}.ds-stub-body{display:flex;flex-direction:column;gap:12px;padding:20px 20px 24px}.ds-stub-body h3{margin:0;font-size:12px;font-weight:700;color:var(--color-muted,#676d7b)}.ds-stub-line{display:flex;justify-content:space-between;gap:16px;font-variant-numeric:tabular-nums}.ds-stub-line i{font-style:normal;color:var(--color-gray-300,#535964)}.ds-stub-add{border-top:1px solid var(--color-gray-500,#e3e5e8);padding-top:12px}.ds-stub-perf{position:relative;height:0}.ds-notch{position:absolute;top:50%;z-index:1;width:28px;height:28px;transform:translateY(-50%);border:1px solid var(--color-gray-500,#e3e5e8);border-radius:9999px;background:var(--color-gray-600,#f9fafa)}.ds-notch-l{left:-14px;clip-path:inset(0 0 0 50%)}.ds-notch-r{right:-14px;clip-path:inset(0 50% 0 0)}.ds-dash{margin:0 14px;border-top:2px dashed var(--color-gray-500,#e3e5e8)}.ds-stub-total{display:flex;align-items:center;justify-content:space-between;padding:24px 20px 20px;border-radius:0 0 10px 10px;background:rgb(46 61 163 / .06)}.ds-stub-total span{font-size:14px;font-weight:700;color:var(--color-blue-dark,#2e3da3)}.ds-stub-total strong{font-size:20px;font-weight:700;font-variant-numeric:tabular-nums}"
    }
  ],
